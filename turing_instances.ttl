    rdfs:label "设计开发事件:E0021"@zh ;
    turing:confidence 0.85 ;
    turing:eventType "设计开发事件" ;
    turing:evidenceSentence "期间他设计了一些加速破译德国密码的技术，包括改进波兰战前研制的机器Bombe，一种可以找到恩尼格玛密码机设置的机电机器" ;
