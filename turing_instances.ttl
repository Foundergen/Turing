    rdfs:label "设计开发事件:E0020"@zh ;
    turing:confidence 0.85 ;
    turing:eventType "设计开发事件" ;
    turing:evidenceSentence "图灵的方法更通用，使用基于恩尼格玛分析，他为此制作了炸弹的功能规范（对波兰炸弹的改进）" ;
    turing:hasObject <http://www.semanticweb.org/turing-kg#%E6%81%A9%E5%B0%BC%E6%A0%BC%E7%8E%9B%E5%AF%86%E7%A0%81%E6%9C%BA> ;
